{
  "name": "pi-helper-desk",
  "version": "0.1.0",
  "description": "Helper Desk for pi: the agent's plan as a purple progress bar above the prompt, with a /helpers pane showing the checklist and a live step feed",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "coedit": {
    "entry": "src/index.ts",
    "outfile": "dist/index.js",
    "format": "esm"
  }
}
