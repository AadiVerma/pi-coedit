{
  "name": "pi-coedit-ledger",
  "version": "0.1.0",
  "description": "Agent cost per commit for the pi coding agent: per-turn token/cost capture, post-commit notes on refs/notes/pi-ledger, show/blame/range/report CLI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "cost",
    "ledger",
    "coedit"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bin": {
    "pi-ledger": "./dist/cli.js",
    "pi-coedit-ledger": "./dist/cli.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@coedit/core": "*",
    "@types/node": "^22.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "coedit": {
    "entry": "src/index.ts",
    "outfile": "dist/index.js",
    "format": "esm",
    "extraEntries": [
      {
        "entry": "src/cli.ts",
        "outfile": "dist/cli.js",
        "banner": "#!/usr/bin/env node"
      },
      {
        "entry": "src/hook.ts",
        "outfile": "dist/hook.js"
      }
    ]
  },
  "files": [
    "dist"
  ]
}
