{
  "name": "pi-coedit",
  "version": "0.1.0",
  "description": "Live human-vs-agent edit awareness for the pi coding agent: overwrite protection, human-edit notes, /whose attribution.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "coedit",
    "attribution"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@coedit/core": "*",
    "@types/node": "^22.18.0"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test --test-force-exit \"test/**/*.test.ts\""
  },
  "coedit": {
    "entry": "src/index.ts",
    "outfile": "dist/index.js",
    "format": "esm"
  },
  "files": [
    "dist"
  ]
}
