{
  "name": "coedit-gutter",
  "displayName": "coedit gutter",
  "description": "Live human-vs-agent line attribution in the gutter (works in VS Code, Cursor, Windsurf) — blue = you, purple = agent, orange = both, grey = unclear.",
  "publisher": "coedit-dev",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AadiVerma/pi-coedit"
  },
  "private": false,
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "coedit.nextAgentChange",
        "title": "coedit: next agent change"
      },
      {
        "command": "coedit.prevAgentChange",
        "title": "coedit: previous agent change"
      },
      {
        "command": "coedit.revertAgentChangesInFile",
        "title": "coedit: revert agent changes in this file"
      },
      {
        "command": "coedit.revertAgentChangesInSelection",
        "title": "coedit: revert agent changes in selection"
      },
      {
        "command": "coedit.toggleColors",
        "title": "coedit: toggle gutter colours"
      },
      {
        "command": "coedit.showWhose",
        "title": "coedit: show whose for this file"
      },
      {
        "command": "coedit.copySessionCommand",
        "title": "coedit: copy pi session command"
      }
    ],
    "configuration": {
      "title": "coedit gutter",
      "properties": {
        "coedit.colorHuman": {
          "type": "string",
          "default": "#4A90D9",
          "description": "Gutter colour for human lines (blue)"
        },
        "coedit.colorAgent": {
          "type": "string",
          "default": "#9B59D0",
          "description": "Gutter colour for agent lines (purple)"
        },
        "coedit.colorBoth": {
          "type": "string",
          "default": "#E8923A",
          "description": "Gutter colour for both lines (orange)"
        },
        "coedit.colorUnknown": {
          "type": "string",
          "default": "#9AA0A6",
          "description": "Gutter colour for unclear lines (grey)"
        },
        "coedit.showBackground": {
          "type": "boolean",
          "default": false,
          "description": "Also tint the line background"
        },
        "coedit.showOverviewRuler": {
          "type": "boolean",
          "default": true,
          "description": "Mark attributed lines in the overview ruler"
        },
        "coedit.storePath": {
          "type": "string",
          "default": "",
          "description": "Override the coedit store directory (defaults to <git-common-dir>/coedit)"
        },
        "coedit.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce for store re-reads"
        }
      }
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "vsce package --no-dependencies -o coedit-gutter.vsix"
  },
  "coedit": {
    "entry": "src/extension.ts",
    "outfile": "dist/extension.js",
    "format": "cjs"
  }
}
